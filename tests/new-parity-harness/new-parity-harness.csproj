<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup><ItemGroup>
<Reference Include="SuikodenRandomizer.Core"><HintPath>$(RuntimePath)/SuikodenRandomizer.Core.dll</HintPath></Reference>
<Reference Include="SuikodenRandomizer.Suikoden2.Core"><HintPath>$(RuntimePath)/SuikodenRandomizer.Suikoden2.Core.dll</HintPath></Reference>
<Reference Include="StarsOfDestiny.Launcher.Core"><HintPath>$(LauncherPath)/StarsOfDestiny.Launcher.Core.dll</HintPath></Reference>
